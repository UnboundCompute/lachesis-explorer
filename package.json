{
  "name": "lachesis-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser companion for Lachesis — read a compiler-precise code property graph: trace where values come from and go, and walk request callpaths, straight from a bundle.json. No server or model in the loop.",
  "license": "MIT",
  "homepage": "https://lachesis.unboundcompute.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnboundCompute/lachesis-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/UnboundCompute/lachesis-explorer/issues"
  },
  "author": "UnboundCompute",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "code-property-graph",
    "static-analysis",
    "code-navigation",
    "dataflow",
    "code-visualization",
    "nextjs",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run verify:bundles && npm run build",
    "verify:bundles": "node scripts/verify-bundles.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
